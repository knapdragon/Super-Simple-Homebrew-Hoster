@using Microsoft.AspNetCore.Identity
@using Super_Simple_Homebrew_Hoster.Areas.Identity.Data;
@inject SignInManager<HomebrewUser> SignInManager
@inject UserManager<HomebrewUser> UserManager

@model Super_Simple_Homebrew_Hoster.Models.HomebrewItemSystemViewModel

@{
    ViewData["Title"] = "Index";

    HomebrewUser? currentUser = UserManager.GetUserAsync(User).Result; // Get the current user
}

<h1>Homebrew Index</h1>

<p>A list of TTRPG homebrew creations</p>

<!-- Users without accounts are not allowed to create, edit or delete items -->
@if (User.Identity.IsAuthenticated) {
    <p>
        <a asp-action="Create">+ Create New</a>
    </p>
}

<!-- Dropdown for the tabletop system to search for -->
<form asp-controller="HomebrewItems" asp-action="Index" method="get">
	<p>
        System(s): 
        <select asp-for="ItemSystem" asp-items="Model.Systems">
            
            <option value="">All</option>
        </select>

        <p>
            <label>Title: <input type="text" name="titleSearch" /></label>
		    <input type="submit" value="Search" />
	    </p>
    </p>
</form>

<!-- 
    Main index table 
    <thead>: The column titles
    <tbody>: Each item's data according to the column, allowing for viewing of details, editing, or deletion
    (Editing & deletion require the User or Admin role)
-->
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HomebrewItems![0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HomebrewItems![0].Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HomebrewItems![0].Source)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HomebrewItems![0].System)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HomebrewItems![0].Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HomebrewItems![0].ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody class="table-striped table-striped-columns">
    <!-- List the details of the item's properties -->
    @foreach (var item in Model.HomebrewItems!) {
        <tr>
            <td>
                <a href="@item.Link">@item.Title</a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Source)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.System)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Author)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseDate)
            </td>
            <!-- Allow editing and deletion if the user is an admin OR is logged in and the item's creator -->
            @if ((User.Identity.IsAuthenticated && currentUser.BrewsCreated.Contains(item.Id)) || User.IsInRole ("Admin")) {
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            } else {
                <!-- Hide edit/delete buttons if user is unregistered -->
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
