@using Microsoft.AspNetCore.Html;
@model Super_Simple_Homebrew_Hoster.Models.HomebrewItem

@using Microsoft.AspNetCore.Identity
@using Super_Simple_Homebrew_Hoster.Areas.Identity.Data;
@inject SignInManager<HomebrewUser> SignInManager
@inject UserManager<HomebrewUser> UserManager

@{
    ViewData["Title"] = "Details";

    var mdContent = Html.DisplayFor(model => model.Content);
}

<h1>Details of @Html.DisplayFor(model => model.Title)</h1>

<div class="d-flex flex-row">
    <p><a class="me-1" asp-action="Index">Back to Index</a></p>
    @if (UserManager.GetUserAsync(User).Result?.UserName == Model?.Author || User.IsInRole("Admin")) {
    	<p class="me-1">| <a asp-action="Edit" asp-route-id="@Model?.Id" class="link-success">Edit</a></p>
        <p class="me-1">| <a asp-action="Delete" asp-route-id="@Model?.Id" class="link-danger">Delete</a></p>
    }
</div>

<!-- Show column titles and data for the item -->
<div>
    <hr />
    <div class="container">
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.Title)</b></div>
            <div class="col-10">@Html.DisplayFor(model => model.Title)</div>
        </div>
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.Type)</b></div>
            <div class="col-10">@Html.DisplayFor(model => model.Type)</div>
        </div>
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.Version)</b></div>
            <div class="col-10">@Html.DisplayFor(model => model.Version)</div>
        </div>
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.Source)</b></div>
            <div class="col-10">@Html.DisplayFor(model => model.Source)</div>
        </div>
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.System)</b></div>
            <div class="col-10">@Html.DisplayFor(model => model.System)</div>
        </div>
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.Author)</b></div>
            <div class="col-10">@Html.DisplayFor(model => model.Author)</div>
        </div>
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.ReleaseDate)</b></div>
            <div class="col-10">@Html.DisplayFor(model => model.ReleaseDate)</div>
        </div>
        <div class="row py-1 border-bottom">
            <div class="col-2"><b>@Html.DisplayNameFor(model => model.Link)</b></div>
            <div class="col-10"><a href="@Model?.Link">@Html.DisplayFor(model => model.Link)</a></div>
        </div>
    </div>

    <div>
        <!-- TinyMCE integrated WYSIWYG editor for Content field -->
        <div class="form-group mb-3 pt-3" style="min-width: 35vw !important; width: 70vw; height: 100% !important">
            <textarea asp-for="Content" class="form-control text-muted">
                @mdContent
            </textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
	</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- Initialise TinyMCE WYSIWYG editor in readonly mode -->
    <script>
        tinymce.init({
            selector: 'textarea',
            editable_root: false,
            height: '100vh',
            plugins: 'anchor autolink charmap codesample lists table visualblocks wordcount linkchecker',
            toolbar: false,
        });
    </script>
}